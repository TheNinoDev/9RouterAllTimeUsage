{
  "manifest_version": 3,
  "name": "9Router All-Time & 60D Usage Extender",
  "version": "1.4.1",
  "description": "Adds All-Time, 60D, and extended period options to 9Router usage dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "license", "enabled": true, "path": "rules/license-csrf.json" }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*/dashboard/usage*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://pwfauth.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*/dashboard/usage*"
      ],
      "js": ["pwf-license.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
